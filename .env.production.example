# Production Application Configuration
PROJECT_NAME="Travel AI Extractor"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="INFO"
PORT=8000
DOMAIN="travel-api.codesec.me"

# API Security Key (Required for API Authentication)
API_KEY="replace_with_strong_random_secret_key"

# External API Keys (Required for Extraction & Places lookup)
GEMINI_API_KEY="replace_with_production_gemini_api_key"
GOOGLE_PLACES_API_KEY="replace_with_production_google_places_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# Database & Cache Configuration (Production Docker Services)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace_with_secure_postgres_password"
POSTGRES_DB="travel_ai_extractor"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"
REDIS_URL="redis://redis:6379/0"

# Storage & Limits
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
